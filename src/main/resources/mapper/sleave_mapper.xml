<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.project.dao.SleaveDAO">
	
	<select id="sawonLeave"
            resultType="sleave">
        select * from sleave where sabun = #{sabun}
    </select>

    <!-- 사원 추가 하며 기본 연차 추가 -->
    <insert id="sleaveInsert" parameterType="sleave">
        insert into sleave values (#{sabun}, 15.0, 0, 0, 0);
    </insert>

    <!-- 연차 사용 -->
    <update id="sleaveApplyUpdate" parameterType="sleavelog">
        update sleave
        <set>
            <choose>
                <when test="leave_type eq 'annual'">
                    annual = annual - #{use_days}
                </when>
                <when test="leave_type eq 'mc'">
                    mc = mc - #{use_days}
                </when>
                <when test="leave_type eq 'health'">
                    health = health - #{use_days}
                </when>
                <when test="leave_type eq 'etc'">
                    etc = etc - #{use_days}
                </when>
            </choose>
        </set>
        where sabun=#{sabun}
    </update>

    <!-- 부서별 휴가현황 연동  -->
    <select id="getDeptVacationList" resultType="map">
    SELECT 
    d.dname AS "deptName",
    COUNT(l.sabun) AS "count"
    FROM sleave_log l
    JOIN sawon s ON l.sabun = s.sabun
    JOIN dept d ON s.deptno = d.deptno
    WHERE l.use_date = #{today}
    AND l.approve = 1
    GROUP BY d.dname
    </select>

    <!-- 승인 대기 연동 -->
    <select id="countPendingLeaves" resultType="int">
    SELECT COUNT(*) 
    FROM sleave_log 
    WHERE approve = 0
    </select>
    
</mapper>