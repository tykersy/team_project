<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.project.dao.DeptDAO">
	
    <!-- 전체 부서 정보 조회 -->
	<select id = "selectAll" parameterType="dept">
        select * from dept
    </select>

    <select id="searchDept"
            parameterType="String"
            resultType="dept">
        select dname, deptno from dept
        where dname like '%' || #{search_name} || '%'
        order by deptno
    </select>
    
</mapper>