<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.project.dao.DeptDAO">
	
    <!-- 전체 부서 정보 조회 -->
	<select id = "selectAll" resultType="dept">
        select * from dept
    </select>

    <!-- 부서이름 검색 -->
    <select id="searchDept"
            parameterType="String"
            resultType="dept">
        select dname, deptno from dept
        where dname like CONCAT('%',#{search_name},'%')
        order by deptno
    </select>

    <!-- 부서1개 정보 조회 -->
    <select id="selectOne"
            parameterType="int"
            resultType="dept">
        select * from dept
        where deptno = #{deptno}
    </select>
    
    <!-- 조직도 정보 조회 -->
    <select id="getDeptOrgChart" resultType="map">
        SELECT 
            d.deptno AS deptNo,
            d.dname AS deptName,
            s.sabun AS sabun,
            s.saname AS saname,
            s.sajob AS sajob
        FROM dept d
        LEFT JOIN sawon s ON d.deptno = s.deptno
        ORDER BY d.deptno, s.sabun
    </select>

    <!-- 부서별 인원 조회 -->
    <select id="memberCount"
            resultType="java.util.Map">
        select d.dname, count(s.sabun) cnt
        from dept d
        left join sawon s
        on d.deptno = s.deptno
        group by d.dname
    </select>

    <!-- 총 부서 갯수 조회 -->
    <select id="deptCnt"
            resultType="int">
        select count(deptno)cnt from dept
    </select>

    <!-- 부서별 사원 수 조회 -->
    <select id="deptCntList" resultType="map">
        SELECT
        d.dname AS deptName,
        COUNT(s.sabun) AS sawonCount
        FROM dept d
        LEFT JOIN sawon s
        ON d.deptno = s.deptno
        GROUP BY d.deptno, d.dname
        ORDER BY sawonCount DESC
    </select>

    <!-- 부서 정보 수정 -->
    <update id="update"
            parameterType="java.util.Map">
        update dept set deptno = #{vo.deptno}, dname = #{vo.dname}, dtel = #{vo.dtel}
        WHERE deptno = #{ori_deptno}
    </update>

    <!-- 부서명, 부서번호 중복체크 -->
    <select id="selectCheck"
            parameterType="dept"
            resultType="dept">
        select * from dept where deptno = #{deptno} and dname = #{dname}
    </select>

    <!-- 부서등록 -->
    <insert id="insertDept"
            parameterType="dept">
        insert into dept values (#{deptno}, #{dname}, #{dtel})
    </insert>

    <!-- 부서 삭제 -->
    <delete id="deleteDept"
            parameterType="String">
        delete from dept where dname = #{dname}
    </delete>
</mapper>