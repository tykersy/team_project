<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.project.dao.SawonDAO">
	
	<select id = "sawonList"
            resultType="sawon">
        select * from sawon
    </select>

    <!-- 사번으로 사원정보 조회 -->
    <select id="selectSawon"
            parameterType="int"
            resultType="sawon">
        select * from sawon where sabun = #{sabun}
    </select>

    <!-- 사원별 정보 조회 -->
    <select id="sawonView"
            parameterType="int"
            resultType="sawon">
        select * from sawon where sabun = #{sabun}
    </select>

    <!-- 사원 추가 -->
    <insert id="sawonInsert" parameterType="sawon">
        insert into sawon values(
            #{sabun},
            #{saname},
            #{deptno},
            #{pwd},
            #{sapay},
            #{sajob},
            #{sahire},
            #{saemail},
            #{satel},
            #{saaddr},
            #{sazipcode}
        )
    </insert>

    <!-- 사원삭제 -->
    <delete id="sawonDelete"
            parameterType="int">
        delete from sawon where sabun = #{sabun}
    </delete>

    <!-- 사원 정보 수정 -->
    <update id="sawonUpdate"
            parameterType="sawon">
        update sawon set saname = #{saname},
                         deptno = #{deptno},
                         pwd = #{pwd},
                         sapay = #{sapay},
                         sajob = #{sajob},
                         sahire = #{sahire},
                         saemail = #{saemail},
                         satel = #{satel},
                         saaddr = #{saaddr},
                         sazipcode = #{sazipcode}
        where sabun = #{sabun}
    </update>

    <!-- 전체 사원 수 조회 -->
    <select id="sawonCnt"
            resultType="int">
        select count(sabun)cnt from sawon
    </select>

    <!-- 최근 충원 부서 조회 -->
    <select id="cur_upd_dept"
            resultType="java.util.Map">
        SELECT s.saname, s.deptno, d.dname
        FROM sawon s
        LEFT JOIN dept d on s.deptno = d.deptno
        ORDER BY s.sahire DESC
        LIMIT 1;
    </select>

    <!-- 최근 충원 직급 조회 -->
    <select id="cur_upd_position"
            resultType="sawon">
        SELECT s.sajob
        FROM sawon s
        LEFT JOIN job_position p on s.sajob = p.sajob
        ORDER BY s.sahire DESC
        LIMIT 1;
    </select>

    <select id="member_list" resultType="sawon">

        SELECT
            s.sabun,
            s.saname,
            s.deptno,
            d.dname
        FROM sawon s
        JOIN dept d
            ON s.deptno = d.deptno
        ORDER BY d.deptno, s.saname

    </select>

    <select id="memberView"
            parameterType="int"
            resultType="sawon">

        select s.*,
            d.dname
        from sawon s
        join dept d
        on s.deptno = d.deptno
        where s.sabun = #{sabun}

    </select>

    <select id="selectSajob"
            parameterType="int"
            resultType="String">
        select sajob from sawon where sabun=#{sabun}
    </select>

</mapper>